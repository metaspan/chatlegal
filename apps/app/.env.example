# Clerk for https://app.chatlegal.uk only.
# https://chatlegal.uk is apps/site (docs and waitlist). Do not point Clerk at that host.
# Keys are issued out of band. Never commit real values.
# Behind nginx, set Host (or X-Forwarded-Host) to app.chatlegal.uk and X-Forwarded-Proto to https.
# No other proxy env keys. The app must not rewrite sign-in to the listen address.
# Development keys look like pk_test_… and sk_test_…. Production keys look like pk_live_… and sk_live_….
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Personal Consumer accounts only. Do not enable Clerk Organizations on this instance.
# Redirects and sign-in URLs are the app host, not chatlegal.uk.
# A local .env.local may use http://localhost:3000 paths while developing. Do not use https://chatlegal.uk.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=https://app.chatlegal.uk/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=https://app.chatlegal.uk/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=https://app.chatlegal.uk/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=https://app.chatlegal.uk/

# Leave unset. This app is the primary Clerk application, not a satellite, and it does not share a cookie domain with chatlegal.uk.
# NEXT_PUBLIC_CLERK_IS_SATELLITE=
# NEXT_PUBLIC_CLERK_DOMAIN=

# Clerk Frontend API. Leave these unset to use the hosted Frontend API for the instance.
# If you proxy that API, the proxy origin is https://app.chatlegal.uk — not https://chatlegal.uk.
# NEXT_PUBLIC_CLERK_FAPI=https://<your-frontend-api>
# NEXT_PUBLIC_CLERK_PROXY_URL=https://app.chatlegal.uk/__clerk
# NEXT_PUBLIC_CLERK_API_URL=https://api.clerk.com

# Clerk Dashboard (set on the instance, not in this repo):
# - Allowed origins / redirect URLs: https://app.chatlegal.uk
# - Do not add https://chatlegal.uk
# - Organizations: off
