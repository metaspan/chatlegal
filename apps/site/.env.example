# Placeholders only. Do not put real keys in git.
# Copy to apps/site/.env for a local build. .env is gitignored.

# Public. Inlined into the static site at build time.
# reCAPTCHA v3 site key. Leave blank to show "Waitlist opening soon".
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Server / waitlist proxy only (apps/site/ops/waitlist-proxy.mjs).
# Never prefix these with NEXT_PUBLIC_. They must not be in the static bundle.
RECAPTCHA_SECRET_KEY=

# Full webhook URL the proxy calls after reCAPTCHA succeeds.
CHATLEGAL_WAITLIST_WEBHOOK_URL=

# Full Authorization header value, including the scheme.
# Example shape only: Bearer <token>
# The proxy sends this value as the Authorization header and does not add "Bearer " itself.
# Leave blank to forward without an Authorization header.
CHATLEGAL_WAITLIST_WEBHOOK_HEADER=
